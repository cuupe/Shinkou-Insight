# Configuration schema only. Runtime reads the root .env file.
TZ=Asia/Shanghai

POSTGRES_DB=shinkou_insight
POSTGRES_USER=postgres
POSTGRES_PASSWORD=shinkou_dev_password
POSTGRES_PORT=15432

REDIS_PASSWORD=shinkou_redis_password
REDIS_PORT=16379

NEO4J_PASSWORD=shinkou_graph_password

# Java -> AI service integration
SHINKOU_AI_SERVICE_URL=http://localhost:8003
SHINKOU_AI_INTERNAL_API_KEY=local-dev-key
SHINKOU_AI_CALLBACK_BASE_URL=http://localhost:8080
# Required and must remain unchanged after credentials are saved. Generate a Base64-encoded 32-byte key.
SHINKOU_ENCRYPTION_KEY=
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512m

MINIO_ROOT_USER=shinkou_minio
MINIO_ROOT_PASSWORD=shinkou_minio_password
MINIO_BUCKET=shinkou-files
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001

# AI service
AI_SERVICE_PORT=8000
INTERNAL_API_KEY=local-dev-key
LLM_MODE=http
# Model endpoint, model id and credentials are configured per user in the web UI.
LLM_TIMEOUT_SECONDS=60
# LangChain structured output strategy: json_schema, function_calling, or json_mode.
LLM_STRUCTURED_OUTPUT_METHOD=json_schema
RETRIEVER_MODE=milvus
DATABASE_URL=postgresql://postgres:shinkou_dev_password@localhost:15432/shinkou_insight
AGENT_TRANSPORT=in-process
# Optional remote workers: planner=http://planner-worker:8000,report_writer=http://writer-worker:8000
AGENT_WORKER_URLS=
# Set on a dedicated worker process, for example planner or report_writer.
AGENT_WORKER_ROLE=
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
MILVUS_URI=http://localhost:19530
AI_MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=
MILVUS_DB_NAME=default
MILVUS_COLLECTION_NAME=shinkou_knowledge_chunks
MILVUS_PORT=19530
MILVUS_WEB_PORT=19091
ENABLE_WEB_SEARCH=false
WEB_SEARCH_PROVIDER=brave
# Search credentials are configured per user in the web UI.
WEB_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search
WEB_SEARCH_LANGUAGE=zh-hans
# External Embedding credentials are configured in the web UI per project.
# The local hash provider keeps development bootable before a project config exists.
EMBEDDING_MODE=hash
EMBEDDING_MODEL=hash-embedding-v1
EMBEDDING_DIMENSION=1536
EMBEDDING_BASE_URL=
STORAGE_MODE=minio
STORAGE_ROOT=./data
MINIO_ENDPOINT=http://minio:9000
AI_MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=shinkou_minio
MINIO_SECRET_KEY=shinkou_minio_password
GRAPH_MODE=memory
GRAPH_EXTRACTION_MODE=heuristic
# Optional MCP extension layer. Keep disabled for the deterministic core path.
MCP_ENABLED=false
MCP_URL=http://localhost:8001/mcp
AI_MCP_URL=http://mcp-server:8001/mcp
MCP_API_KEY=local-dev-key
MCP_ALLOWED_TOOLS=search_knowledge,search_graph
MCP_TRANSPORT=streamable-http
MCP_TIMEOUT_SECONDS=15
MCP_PORT=8001
NEO4J_URI=bolt://localhost:7687
AI_NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=shinkou_graph_password
