# Docker infrastructure defaults. Copy to .env for local use.
TZ=Asia/Shanghai

POSTGRES_DB=shinkou_insight
POSTGRES_USER=postgres
POSTGRES_PASSWORD=shinkou_dev_password
POSTGRES_PORT=15432

REDIS_PASSWORD=shinkou_redis_password
REDIS_PORT=16379

NEO4J_PASSWORD=shinkou_graph_password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512m

MINIO_ROOT_USER=shinkou_minio
MINIO_ROOT_PASSWORD=shinkou_minio_password
MINIO_BUCKET=shinkou-files
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001
